<?xml version="1.0" encoding="UTF-8"?>
<classpath>
  <!-- JDK -->
  <classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-17"/>

  <!-- ソースフォルダ -->
  <classpathentry kind="src" path="src/main/java"/>
  <classpathentry kind="src" path="src/test/java"/>

  <!-- サーバー (Tomcat 10) -->
  <classpathentry kind="con" path="org.eclipse.jst.server.core.container/org.eclipse.jst.server.tomcat.runtimeTarget/Tomcat10 (Java17)"/>
  <classpathentry kind="con" path="org.eclipse.jst.j2ee.internal.web.container"/>
  <classpathentry kind="con" path="org.eclipse.jst.j2ee.internal.module.container"/>

  <!-- JUnit -->
  <classpathentry kind="con" path="org.eclipse.jdt.junit.JUNIT_CONTAINER/5"/>

  <!-- 手動追加したライブラリ -->
  <classpathentry kind="lib" path="src/main/webapp/WEB-INF/lib/jakarta.servlet.jsp.jstl-3.0.1.jar"/>
  <classpathentry kind="lib" path="src/main/webapp/WEB-INF/lib/jakarta.servlet.jsp.jstl-api-3.0.2.jar"/>
  <classpathentry kind="lib" path="src/main/webapp/WEB-INF/lib/mysql-connector-j-9.3.0.jar"/>
  <classpathentry kind="lib" path="src/main/webapp/WEB-INF/lib/objenesis-3.4.jar"/>
  <classpathentry kind="lib" path="src/main/webapp/WEB-INF/lib/byte-buddy-1.17.7.jar"/>
  <classpathentry kind="lib" path="src/main/webapp/WEB-INF/lib/byte-buddy-agent-1.17.7.jar"/>
  <classpathentry kind="lib" path="src/main/webapp/WEB-INF/lib/mockito-core-5.19.0.jar"/>

  <!-- 出力先 -->
  <classpathentry kind="output" path="build/classes"/>
</classpath>
